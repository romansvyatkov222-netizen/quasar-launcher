# PostgreSQL: пользователя/пароль/базу создай заранее
DATABASE_URL="postgresql://quasar:quasar@localhost:5432/quasar"

PORT=3000
NODE_ENV="development"

# Секрет для JWT — минимум 32 символа, сгенерируй: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CHANGE_ME_min_32_chars_secret_key"
JWT_EXPIRES_IN="12h"

# Эталонный хэш клиента. Пусто = проверка отключена. Rust-ядро присылает его в login.
CLIENT_HASH=""

# Список origins через запятую, * = разрешить все
CORS_ORIGIN="*"
